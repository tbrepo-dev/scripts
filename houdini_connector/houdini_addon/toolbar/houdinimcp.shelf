<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <toolshelf name="houdinimcp" label="MCP">
    <memberTool name="houdinimcp_start"/>
    <memberTool name="houdinimcp_stop"/>
  </toolshelf>

  <tool name="houdinimcp_start" label="Start MCP" icon="NETWORKS_top">
    <script scriptType="python"><![CDATA[import hou
import houdinimcp

if houdinimcp.is_server_running():
    server = hou.session.houdinimcp_server
    hou.ui.setStatusMessage(f"HoudiniMCP Server is already running on {server.host}:{server.port}")
else:
    houdinimcp.start_server()
    if houdinimcp.is_server_running():
        server = hou.session.houdinimcp_server
        hou.ui.setStatusMessage(f"HoudiniMCP Server started on {server.host}:{server.port}")
    else:
        hou.ui.displayMessage("HoudiniMCP Server failed to start - see the Python Shell for details")
]]></script>
  </tool>

  <tool name="houdinimcp_stop" label="Stop MCP" icon="BUTTONS_delete">
    <script scriptType="python"><![CDATA[import hou
import houdinimcp

if houdinimcp.is_server_running():
    houdinimcp.stop_server()
    hou.ui.setStatusMessage("HoudiniMCP Server stopped")
else:
    hou.ui.setStatusMessage("HoudiniMCP Server is not running")
]]></script>
  </tool>
</shelfDocument>
